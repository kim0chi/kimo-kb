[Unit]
Description=Kimo workspace Cloudflare Tunnel
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/srv/kimo/secrets/cloudflare-tunnel-token

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/srv/kimo/secrets/cloudflare-tunnel-token
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
